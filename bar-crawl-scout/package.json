{
  "name": "bar-crawl-scout",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Sleeper keeper-league scouting board for the Official Bar Crawl Order league.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "token-lint": "node scripts/token-lint.mjs",
    "bundle-budget": "node scripts/bundle-budget.mjs",
    "drift": "tsx scripts/drift-check.ts",
    "smoke": "playwright test --config playwright.smoke.config.js",
    "capture": "node scripts/capture-fixtures.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@testing-library/svelte": "^5.2.4",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^24.1.0",
    "svelte": "^4.2.19",
    "tsx": "^4.23.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.8",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.2.8",
    "@fontsource/archivo-black": "^5.2.8",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@tanstack/svelte-query": "^5.90.2",
    "idb-keyval": "^6.2.6"
  }
}
